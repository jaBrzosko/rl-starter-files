PREFIX : <http://example.org/minigrid#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?rec ?maskWeight ?maskedActionIndex
WHERE {
    # Bind the target map ID
    BIND("MAP_ID_REPLACE" AS ?targetMapId)
    
    # Get the target map
    ?map a :Map ;
         :mapId ?targetMapId .
  
    # Get all recommendations and their masks
    ?rec a :Recommendation ;
        :hasMask ?mask .
  
  	?mask :masksAction ?maskedAction ;
         :maskWeight ?maskWeight .
  
  	?maskedAction :actionIndex ?maskedActionIndex .
  
  	OPTIONAL {
    	?rec :hasRequirement ?req .
    	?req :requiresCellType ?reqCellType ;
          	:positionX ?reqX ;
          	:positionY ?reqY .
    	
    	?reqCellType :channelValue ?reqChannelValue .
  	}
  
  	OPTIONAL {
    	FILTER(BOUND(?reqChannelValue)) .
    
    	?map :hasCell ?cell .
        ?cell :coordinateX ?cellX ;
              :coordinateY ?cellY ;
              :channelValue ?cellValue .
    
	    FILTER(?reqX = ?cellX && ?reqY = ?cellY && ?reqChannelValue = ?cellValue) .
    
    	# This should not work this way, but otherwise I cannot bind ?requirement
    	?req a :Requirement .
	    BIND(?req as ?satisfiedReq) .
  	}
}
GROUP BY ?rec ?maskWeight ?maskedActionIndex
# Only return rules where the count of all requirements
# is equal to the count of satisfied requirements
HAVING (COUNT(DISTINCT ?req) = COUNT(DISTINCT ?satisfiedReq))
