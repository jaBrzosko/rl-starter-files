@prefix mg: <http://example.org/minigrid#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Actions

mg:action_left a mg:Action ;
    mg:actionName "left" ;
    mg:actionIndex "0"^^xsd:int .

mg:action_right a mg:Action ;
    mg:actionName "right" ;
    mg:actionIndex "1"^^xsd:int .

mg:action_forward a mg:Action ;
    mg:actionName "forward" ;
    mg:actionIndex "2"^^xsd:int .

mg:action_pickup a mg:Action ;
    mg:actionName "pickup" ;
    mg:actionIndex "3"^^xsd:int .

mg:action_drop a mg:Action ;
    mg:actionName "drop" ;
    mg:actionIndex "4"^^xsd:int .

mg:action_toggle a mg:Action ;
    mg:actionName "toggle" ;
    mg:actionIndex "5"^^xsd:int .

mg:action_done a mg:Action ;
    mg:actionName "done" ;
    mg:actionIndex "6"^^xsd:int .

# Cell Types and channel values

mg:cellType_empty a mg:CellType ;
    mg:cellTypeName "empty" ;
    mg:channelValue "1,0,0" .

mg:cellType_wall a mg:CellType ;
    mg:cellTypeName "wall" ;
    mg:channelValue "2,5,0" .

mg:cellType_lava a mg:CellType ;
    mg:cellTypeName "lava" ;
    mg:channelValue "9,0,0" .

mg:cellType_unseen a mg:CellType ;
    mg:cellTypeName "unseen" ;
    mg:channelValue "0,0,0" .

mg:cellType_goal a mg:CellType ;
    mg:cellTypeName "goal" ;
    mg:channelValue "8,1,0" .

# Problem Types

mg:problemType_crossing a mg:ProblemType ;
    mg:problemTypeName "crossing" ;
    mg:problemTypeDescription "A minigrid environment where the agent must navigate through a crossing of lava" ;
    mg:problemTypeDocumentationLink "https://minigrid.farama.org/environments/minigrid/CrossingEnv/" .

# Masks

mg:mask_no_forward a mg:Mask ;
    mg:maskDescription "Masks the forward action completely." ;
    mg:maskWeight "1.0"^^xsd:decimal ;
    mg:masksAction mg:action_forward .

mg:mask_no_pickup a mg:Mask ;
    mg:maskDescription "Masks the pickup action completely." ;
    mg:maskWeight "1.0"^^xsd:decimal ;
    mg:masksAction mg:action_pickup .

mg:mask_no_drop a mg:Mask ;
    mg:maskDescription "Masks the drop action completely." ;
    mg:maskWeight "1.0"^^xsd:decimal ;
    mg:masksAction mg:action_drop .

mg:mask_no_toggle a mg:Mask ;
    mg:maskDescription "Masks the toggle action completely." ;
    mg:maskWeight "1.0"^^xsd:decimal ;
    mg:masksAction mg:action_toggle .

mg:mask_no_done a mg:Mask ;
    mg:maskDescription "Masks the done action completely." ;
    mg:maskWeight "1.0"^^xsd:decimal ;
    mg:masksAction mg:action_done .

# =======================================
# Recommendations
# =======================================

# Lava Avoidance Recommendation

mg:recommendation_avoid_lava a mg:Recommendation ;
    mg:recommendationId "rec_avoid_lava" ;
    mg:recommendationName "Avoid Lava" ;
    mg:recommendationDescription "This recommendation advises the agent to avoid stepping into lava cells directly in front of them." ;
    mg:hasProblemType mg:problemType_crossing ;
    mg:hasMask mg:mask_no_forward ;
    mg:hasRequirement mg:requirement_lava_ahead .

mg:requirement_lava_ahead a mg:Requirement ;
    mg:positionX "3"^^xsd:int ;
    mg:positionY "6"^^xsd:int ;
    mg:requiresCellType mg:cellType_lava .

# Wall Ahead Recommendation

mg:recommendation_avoid_wall a mg:Recommendation ;
    mg:recommendationId "rec_avoid_wall" ;
    mg:recommendationName "Avoid Wall" ;
    mg:recommendationDescription "This recommendation advises the agent to avoid moving forward when there is a wall directly in front of them." ;
    mg:hasProblemType mg:problemType_crossing ;
    mg:hasMask mg:mask_no_forward ;
    mg:hasRequirement mg:requirement_wall_ahead .

mg:requirement_wall_ahead a mg:Requirement ;
    mg:positionX "3"^^xsd:int ;
    mg:positionY "6"^^xsd:int ;
    mg:requiresCellType mg:cellType_wall .

# Unused Actions Masking Recommendation

mg:recommendation_mask_unused_crossing a mg:Recommendation ;
    mg:recommendationId "rec_mask_unused_crossing" ;
    mg:recommendationName "Mask Unused Actions for Crossing" ;
    mg:recommendationDescription "This recommendation suggests masking actions that are not useful in crossing environments." ;
    mg:hasProblemType mg:problemType_crossing ;
    mg:hasMask mg:mask_no_pickup, mg:mask_no_drop, mg:mask_no_toggle, mg:mask_no_done .

# Wall Guessing Recommendation

mg:recommendation_guess_walls_left a mg:Recommendation ;
    mg:recommendationId "rec_guess_walls_left" ;
    mg:recommendationName "Guess Walls on the Left" ;
    mg:recommendationDescription "This recommendation advises the agent to guess that walls are located to its left when navigating crossing environments." ;
    mg:hasProblemType mg:problemType_crossing ;
    mg:hasMask mg:mask_crossing_maybe_no_left ;
    mg:hasRequirement mg:requirement_guess_walls_left_first, mg:requirement_guess_walls_left_second .

mg:mask_crossing_maybe_no_left a mg:Mask ;
    mg:maskDescription "Partial masking of the left action in crossing environments." ;
    mg:maskWeight "0.5"^^xsd:decimal ;
    mg:masksAction mg:action_left .

mg:requirement_guess_walls_left_first a mg:Requirement ;
    mg:positionX "2"^^xsd:int ;
    mg:positionY "6"^^xsd:int ;
    mg:requiresCellType mg:cellType_wall .

mg:requirement_guess_walls_left_second a mg:Requirement ;
    mg:positionX "2"^^xsd:int ;
    mg:positionY "5"^^xsd:int ;
    mg:requiresCellType mg:cellType_wall .

mg:recommendation_guess_walls_right a mg:Recommendation ;
    mg:recommendationId "rec_guess_walls_right" ;
    mg:recommendationName "Guess Walls on the Right" ;
    mg:recommendationDescription "This recommendation advises the agent to guess that walls are located to its right when navigating crossing environments." ;
    mg:hasProblemType mg:problemType_crossing ;
    mg:hasMask mg:mask_crossing_maybe_no_right ;
    mg:hasRequirement mg:requirement_guess_walls_right_first, mg:requirement_guess_walls_right_second .

mg:mask_crossing_maybe_no_right a mg:Mask ;
    mg:maskDescription "Partial masking of the right action in crossing environments." ;
    mg:maskWeight "0.5"^^xsd:decimal ;
    mg:masksAction mg:action_right .

mg:requirement_guess_walls_right_first a mg:Requirement ;
    mg:positionX "4"^^xsd:int ;
    mg:positionY "6"^^xsd:int ;
    mg:requiresCellType mg:cellType_wall .

mg:requirement_guess_walls_right_second a mg:Requirement ;
    mg:positionX "4"^^xsd:int ;
    mg:positionY "5"^^xsd:int ;
    mg:requiresCellType mg:cellType_wall .

# Goal Ahead Recommendation
mg:recommendation_move_towards_gaol_1F a mg:Recommendation ;
    mg:recommendationId "rec_move_towards_goal_1F" ;
    mg:recommendationName "Move Towards Goal 1 Forward" ;
    mg:recommendationDescription "This recommendation advises the agent to move forward when the goal is directly ahead." ;
    mg:hasProblemType mg:problemType_crossing ;
    mg:hasRequirement mg:requirement_goal_ahead_1F ;
    mg:hasMask mg:mask_almost_no_left, mg:mask_almost_no_right .

mg:requirement_goal_ahead_1F a mg:Requirement ;
    mg:positionX "3"^^xsd:int ;
    mg:positionY "6"^^xsd:int ;
    mg:requiresCellType mg:cellType_goal .

mg:mask_almost_no_left a mg:Mask ;
    mg:maskDescription "Almost completely masks the left action." ;
    mg:maskWeight "0.9"^^xsd:decimal ;
    mg:masksAction mg:action_left .

mg:mask_almost_no_right a mg:Mask ;
    mg:maskDescription "Almost completely masks the right action." ;
    mg:maskWeight "0.9"^^xsd:decimal ;
    mg:masksAction mg:action_right .

mg:recommendation_move_towards_gaol_2F a mg:Recommendation ;
    mg:recommendationId "rec_move_towards_goal_2F" ;
    mg:recommendationName "Move Towards Goal 2 Forward" ;
    mg:recommendationDescription "This recommendation advises the agent to move forward when the goal is two steps ahead and one step forward is clear." ;
    mg:hasProblemType mg:problemType_crossing ;
    mg:hasRequirement mg:requirement_goal_ahead_2F, mg:requirement_goal_ahead_1F_clear ;
    mg:hasMask mg:mask_almost_no_left, mg:mask_almost_no_right .

mg:requirement_goal_ahead_2F a mg:Requirement ;
    mg:positionX "3"^^xsd:int ;
    mg:positionY "5"^^xsd:int ;
    mg:requiresCellType mg:cellType_goal .

mg:requirement_goal_ahead_1F_clear a mg:Requirement ;
    mg:positionX "3"^^xsd:int ;
    mg:positionY "6"^^xsd:int ;
    mg:requiresCellType mg:cellType_empty .

mg:recommendation_move_towards_gaol_3F a mg:Recommendation ;
    mg:recommendationId "rec_move_towards_goal_3F" ;
    mg:recommendationName "Move Towards Goal 3 Forward" ;
    mg:recommendationDescription "This recommendation advises the agent to move forward when the goal is three steps ahead and the first two steps forward are clear." ;
    mg:hasProblemType mg:problemType_crossing ;
    mg:hasRequirement mg:requirement_goal_ahead_3F, mg:requirement_goal_ahead_2F_clear, mg:requirement_goal_ahead_1F_clear ;
    mg:hasMask mg:mask_almost_no_left, mg:mask_almost_no_right .

mg:requirement_goal_ahead_3F a mg:Requirement ;
    mg:positionX "3"^^xsd:int ;
    mg:positionY "4"^^xsd:int ;
    mg:requiresCellType mg:cellType_goal .

mg:requirement_goal_ahead_2F_clear a mg:Requirement ;
    mg:positionX "3"^^xsd:int ;
    mg:positionY "5"^^xsd:int ;
    mg:requiresCellType mg:cellType_empty .

# Goal Diagonal Recommendation - Left

mg:recommendation_move_towards_goal_diag_left a mg:Recommendation ;
    mg:recommendationId "rec_move_towards_goal_diag_left" ;
    mg:recommendationName "Move Towards Goal Diagonal Left " ;
    mg:recommendationDescription "This recommendation advises the agent to go straight (and then left) when the goal is diagonally left ahead." ;
    mg:hasProblemType mg:problemType_crossing ;
    mg:hasRequirement mg:requirement_goal_diag_left_1F, mg:requirement_goal_ahead_1F_clear ;
    mg:hasMask mg:mask_almost_no_right, mg:mask_crossing_maybe_no_left .

mg:requirement_goal_diag_left_1F a mg:Requirement ;
    mg:positionX "2"^^xsd:int ;
    mg:positionY "6"^^xsd:int ;
    mg:requiresCellType mg:cellType_goal .

mg:recommendation_move_towards_goal_diag_left_2F_1L a mg:Recommendation ;
    mg:recommendationId "rec_move_towards_goal_diag_left_2F_1L" ;
    mg:recommendationName "Move Towards Goal Diagonal Left 2 Forward 1 Left" ;
    mg:recommendationDescription "This recommendation advises the agent to go straight for two steps (and then left) when the goal is diagonally left ahead." ;
    mg:hasProblemType mg:problemType_crossing ;
    mg:hasRequirement mg:requirement_goal_diag_left_2F_1L, mg:requirement_goal_ahead_2F_clear, mg:requirement_goal_ahead_1F_clear ;
    mg:hasMask mg:mask_almost_no_right, mg:mask_crossing_maybe_no_left .

mg:requirement_goal_diag_left_2F_1L a mg:Requirement ;
    mg:positionX "2"^^xsd:int ;
    mg:positionY "5"^^xsd:int ;
    mg:requiresCellType mg:cellType_goal .

mg:recommendation_move_towards_goal_diag_left_1F_2L a mg:Recommendation ;
    mg:recommendationId "rec_move_towards_goal_diag_left_1F_2L" ;
    mg:recommendationName "Move Towards Goal Diagonal Left 1 Forward 2 Left" ;
    mg:recommendationDescription "This recommendation advises the agent to go straight for one step (and then left twice) when the goal is diagonally left ahead." ;
    mg:hasProblemType mg:problemType_crossing ;
    mg:hasRequirement mg:requirement_goal_diag_left_1F_2L, mg:requirement_goal_ahead_1F_1L_clear, mg:requirement_goal_ahead_1F_clear ;
    mg:hasMask mg:mask_almost_no_right, mg:mask_crossing_maybe_no_left .

mg:requirement_goal_diag_left_1F_2L a mg:Requirement ;
    mg:positionX "1"^^xsd:int ;
    mg:positionY "6"^^xsd:int ;
    mg:requiresCellType mg:cellType_goal .

mg:requirement_goal_diag_1F_1L_clear a mg:Requirement ;
    mg:positionX "2"^^xsd:int ;
    mg:positionY "6"^^xsd:int ;
    mg:requiresCellType mg:cellType_empty .


# Goal Diagonal Recommendation - Right

mg:recommendation_move_towards_goal_diag_right a mg:Recommendation ;
    mg:recommendationId "rec_move_towards_goal_diag_right" ;
    mg:recommendationName "Move Towards Goal Diagonal Right " ;
    mg:recommendationDescription "This recommendation advises the agent to go straight (and then right) when the goal is diagonally right ahead." ;
    mg:hasProblemType mg:problemType_crossing ;
    mg:hasRequirement mg:requirement_goal_diag_right_1F, mg:requirement_goal_ahead_1F_clear ;
    mg:hasMask mg:mask_almost_no_left, mg:mask_crossing_maybe_no_right .

mg:requirement_goal_diag_right_1F a mg:Requirement ;
    mg:positionX "4"^^xsd:int ;
    mg:positionY "6"^^xsd:int ;
    mg:requiresCellType mg:cellType_goal .

mg:recommendation_move_towards_goal_diag_right_2F_2R a mg:Recommendation ;
    mg:recommendationId "rec_move_towards_goal_diag_right_2F_@r" ;
    mg:recommendationName "Move Towards Goal Diagonal Right 2 Forward 1 Right" ;
    mg:recommendationDescription "This recommendation advises the agent to go straight for two steps (and then right) when the goal is diagonally right ahead." ;
    mg:hasProblemType mg:problemType_crossing ;
    mg:hasRequirement mg:requirement_goal_diag_right_2F_1R, mg:requirement_goal_ahead_2F_clear, mg:requirement_goal_ahead_1F_clear ;
    mg:hasMask mg:mask_almost_no_left, mg:mask_crossing_maybe_no_right .

mg:requirement_goal_diag_right_2F_1R a mg:Requirement ;
    mg:positionX "4"^^xsd:int ;
    mg:positionY "5"^^xsd:int ;
    mg:requiresCellType mg:cellType_goal .

mg:recommendation_move_towards_goal_diag_right_1F_2R a mg:Recommendation ;
    mg:recommendationId "rec_move_towards_goal_diag_right_1F_2R" ;
    mg:recommendationName "Move Towards Goal Diagonal Right 1 Forward 2 Right" ;
    mg:recommendationDescription "This recommendation advises the agent to go straight for one step (and then right twice) when the goal is diagonally right ahead." ;
    mg:hasProblemType mg:problemType_crossing ;
    mg:hasRequirement mg:requirement_goal_diag_right_1F_2R, mg:requirement_goal_ahead_1F_1R_clear, mg:requirement_goal_ahead_1F_clear ;
    mg:hasMask mg:mask_almost_no_left, mg:mask_crossing_maybe_no_right .

mg:requirement_goal_diag_right_1F_2R a mg:Requirement ;
    mg:positionX "5"^^xsd:int ;
    mg:positionY "6"^^xsd:int ;
    mg:requiresCellType mg:cellType_goal .

mg:requirement_goal_diag_1F_1R_clear a mg:Requirement ;
    mg:positionX "4"^^xsd:int ;
    mg:positionY "6"^^xsd:int ;
    mg:requiresCellType mg:cellType_empty .
